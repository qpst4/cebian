<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.slideindex.app.imageeditor.ui.ImageEditorView
        android:id="@+id/editorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/modeQuickToolsHost"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/modeQuickToolsContainer"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/compactAddTextButton"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/inspire_image_edit_add_text"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                style="@style/Widget.Material3.Button.TextButton"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/compactBrushPanel"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <com.slideindex.app.imageeditor.ui.BrushSizePreviewView
                    android:id="@+id/compactBrushPreview"
                    android:padding="1dp"
                    android:layout_width="26dp"
                    android:layout_height="26dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/compactShapePanel"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">
                <FrameLayout
                    android:id="@+id/compactShapePreviewContainer"
                    android:layout_width="28dp"
                    android:layout_height="28dp">
                    <com.slideindex.app.imageeditor.ui.ShapeTypePreviewView
                        android:id="@+id/compactShapePreview"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/compactColorPanel"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">
                <FrameLayout
                    android:id="@+id/compactColorPreviewContainer"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="2dp">
                    <View
                        android:layout_gravity="center"
                        android:id="@+id/compactColorPreview"
                        android:layout_width="20dp"
                        android:layout_height="20dp"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomPanel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomBarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="5dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <HorizontalScrollView
                    android:id="@+id/modeActionsScroll"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:fillViewport="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/modeActionsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:divider="@android:color/transparent"
                        android:showDividers="middle"
                        android:dividerPadding="6dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeNavigate"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/inspire_image_edit_mode_browse"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            style="@style/Widget.Material3.Button.TextButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeCrop"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/inspire_image_edit_mode_crop"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            style="@style/Widget.Material3.Button.TextButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeDoodle"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/inspire_image_edit_mode_doodle"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            style="@style/Widget.Material3.Button.TextButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeEraser"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/inspire_image_edit_mode_eraser"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            style="@style/Widget.Material3.Button.TextButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeShape"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/inspire_image_edit_mode_shape"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            style="@style/Widget.Material3.Button.TextButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeText"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/inspire_image_edit_mode_text"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            style="@style/Widget.Material3.Button.TextButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modeMosaic"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/inspire_image_edit_mode_mosaic"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            style="@style/Widget.Material3.Button.TextButton"/>
                    </LinearLayout>
                </HorizontalScrollView>
                <View
                    android:background="?attr/colorOutlineVariant"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/cropActionsGroup"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:weightSum="2"
                        android:layout_weight="1">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTopClearCrop"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/inspire_image_edit_crop_clear"
                            android:layout_weight="1"
                            style="@style/Widget.Material3.Button.TextButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTopApplyCrop"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="@string/inspire_image_edit_crop_apply"
                            android:layout_weight="1"
                            style="@style/Widget.Material3.Button.TextButton"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/defaultTopActionsGroup"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:weightSum="7"
                        android:layout_weight="1">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClose"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/inspire_image_edit_exit"
                            app:icon="@drawable/baseline_arrow_back_24"
                            style="@style/Widget.Material3.Button.TextButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUndo"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/inspire_image_edit_undo"
                            app:icon="@drawable/undo_24px"
                            style="@style/Widget.Material3.Button.IconButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRedo"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/inspire_image_edit_redo"
                            app:icon="@drawable/redo_24px"
                            style="@style/Widget.Material3.Button.IconButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPin"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/inspire_image_edit_pin"
                            app:icon="@drawable/baseline_push_pin_24"
                            style="@style/Widget.Material3.Button.IconButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopy"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/inspire_image_edit_copy"
                            app:icon="@drawable/ic_baseline_content_copy_24"
                            style="@style/Widget.Material3.Button.IconButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShare"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/inspire_image_edit_share"
                            app:icon="@drawable/ic_baseline_share_24"
                            style="@style/Widget.Material3.Button.IconButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSave"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/inspire_image_edit_done"
                            app:icon="@drawable/baseline_save_24"
                            style="@style/Widget.Material3.Button.IconButton"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
